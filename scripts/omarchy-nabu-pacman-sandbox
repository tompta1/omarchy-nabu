#!/usr/bin/env python3
"""Select pacman's filesystem sandbox from the running kernel's Landlock ABI."""
import ctypes
import errno
import os
from pathlib import Path
import platform
import tempfile


def landlock_abi():
    # __NR_landlock_create_ruleset is 444 on the target and native test host.
    # Query the running kernel, not a version/config which may omit the LSM.
    if platform.machine() not in ('aarch64', 'x86_64'):
        raise OSError(errno.ENOTSUP, 'Landlock probe architecture is unsupported')
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long
    result = libc.syscall(ctypes.c_long(444), ctypes.c_void_p(),
                          ctypes.c_size_t(0), ctypes.c_uint(1))
    if result > 0:
        return result
    error = ctypes.get_errno() if result < 0 else errno.EIO
    if error in (errno.ENOSYS, errno.EOPNOTSUPP):
        return 0
    raise OSError(error, 'Landlock ABI probe failed: '+os.strerror(error))


def render(abi):
    text = '# Generated by omarchy-nabu-pacman-sandbox at boot and config refresh.\n'
    if abi is None:
        return text + '# Landlock probe failed: filesystem sandbox left enabled.\n'
    if abi > 0:
        return text + f'# Landlock ABI {abi}: filesystem sandbox enabled.\n'
    return text + '# Landlock unavailable: stock-kernel compatibility.\nDisableSandboxFilesystem\n'


def write_policy(path, abi):
    path = Path(path)
    text = render(abi)
    if path.exists() and path.read_text() == text:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(text)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def refresh_policy(path):
    try:
        abi = landlock_abi()
    except OSError:
        write_policy(path, None)
        raise
    write_policy(path, abi)
    return abi


if __name__ == '__main__':
    if os.geteuid() != 0:
        raise SystemExit('Run as root to select pacman sandbox compatibility.')
    try:
        abi = refresh_policy('/etc/pacman.d/omarchy-nabu-sandbox.conf')
    except OSError as error:
        raise SystemExit(str(error)) from error
    print(f'Landlock ABI {abi}; pacman filesystem sandbox ' + ('enabled' if abi else 'unavailable'))
