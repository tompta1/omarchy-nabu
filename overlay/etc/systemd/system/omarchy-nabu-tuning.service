[Unit]
Description=Apply supported Omarchy tunings for Xiaomi Nabu
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-sysctl.service systemd-udev-trigger.service sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/omarchy-nabu-tuning
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/sysctl.d /etc/udev/rules.d
# Connected /var/tmp isolation can order this unit after tmpfiles-setup,
# which needs the local filesystems this unit precedes via udev coldplug.
PrivateTmp=disconnected

[Install]
WantedBy=sysinit.target
