FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc-aarch64-linux-gnu binutils-aarch64-linux-gnu libc6-dev-arm64-cross \
    bc bison flex libssl-dev libelf-dev python3 git ca-certificates \
    kmod device-tree-compiler cpio rsync zstd xz-utils file bsdextrautils pahole \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /project
ENTRYPOINT ["/bin/bash"]
