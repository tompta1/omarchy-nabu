+void iris_vpu_trace_pm(struct iris_core *core, const char *phase)
+{
+	if (!iris_vpu_uses_legacy_vpu5(core))
+		return;
+
+	/* Do not access registers from the PM callbacks themselves. */
+	core->pm_trace_pending = true;
+	dev_info(core->dev, "HW08 PM %s state=%u runtime_active=%d\n",
+		 phase, core->state, pm_runtime_active(core->dev));
+}
+
+static void iris_vpu5_trace_command(struct iris_core *core)
+{
+	u32 cpu = iris_vpu_cpu_cs_base(core);
+	u32 wrapper = iris_vpu_wrapper_base(core);
+	u32 ctrl, qinfo, qaddr, mask, status;
+
+	if (!core->pm_trace_pending)
+		return;
+	core->pm_trace_pending = false;
+
+	/*
+	 * Read only registers already used by this driver's boot/IRQ paths,
+	 * at a command submission where it is already accessing the VPU.
+	 * Log once after power-on or a PM callback, not once per packet.
+	 */
+	ctrl = readl(core->reg_base + cpu + 0x4c);
+	qinfo = readl(core->reg_base + cpu + 0x50);
+	qaddr = readl(core->reg_base + cpu + 0x54);
+	mask = readl(core->reg_base + wrapper + 0x10);
+	status = readl(core->reg_base + wrapper + 0x0c);
+	dev_info(core->dev,
+		 "HW08 command ctrl=%#x qinfo=%#x qaddr_matches=%u irq_mask=%#x irq_status=%#x\n",
+		 ctrl, qinfo, qaddr == (u32)core->iface_q_table_daddr, mask, status);
+}
+
 void iris_vpu_raise_interrupt(struct iris_core *core)
 {
-	if (iris_vpu_uses_legacy_vpu5(core))
+	if (iris_vpu_uses_legacy_vpu5(core)) {
 		writel(BIT(15), core->reg_base + VPU5_CPU_IC_BASE_OFFS + 0x18);
-	else
+		iris_vpu5_trace_command(core);
+	} else {
 		writel(1 << CPU_IC_SOFTINT_H2A_SHFT, core->reg_base + CPU_IC_SOFTINT);
+	}
 }
 
 void iris_vpu_clear_interrupt(struct iris_core *core)
@@ -726,6 +764,7 @@ int iris_vpu_power_on(struct iris_core *core)
 
 	iris_vpu_interrupt_init(core);
 	core->intr_status = 0;
+	iris_vpu_trace_pm(core, "power-on");
 	enable_irq(core->irq);
 
 	return 0;
