+static int iris_vpu5_prepare_pc(struct iris_core *core)
+{
+	u32 ctrl_reg = iris_vpu_cpu_cs_base(core) + 0x4c;
+	u32 cpu_reg = iris_vpu_wrapper_base(core) + 0x2014;
+	u32 ctrl;
+	int ret;
+
+	/* VPU5 uses the non-TZ wrapper WFI bit, as in downstream Iris1. */
+	ctrl = readl(core->reg_base + ctrl_reg);
+	if (ctrl & CTRL_STATUS_PC_READY)
+		return 0;
+
+	ret = readl_poll_timeout(core->reg_base + ctrl_reg, ctrl,
+				 (ctrl & CTRL_INIT_IDLE_MSG_BMSK) &&
+				 (readl(core->reg_base + cpu_reg) & BIT(0)),
+				 1500, 150000);
+	if (ret)
+		goto error;
+
+	ret = core->hfi_sys_ops->sys_pc_prep(core);
+	if (ret)
+		goto error;
+
+	ret = readl_poll_timeout(core->reg_base + ctrl_reg, ctrl,
+				 (ctrl & CTRL_STATUS_PC_READY) &&
+				 (readl(core->reg_base + cpu_reg) & BIT(0)),
+				 1500, 150000);
+	if (!ret)
+		return 0;
+
+error:
+	dev_err(core->dev, "VPU5 not ready for power collapse: %d ctrl=%#x\n",
+		ret, ctrl);
+	return ret;
+}
+
+static void iris_vpu_power_off_resources(struct iris_core *core);
+
+static void iris_vpu5_pm_power_off(struct iris_core *core)
+{
+	if (!core->vpu_powered)
+		return;
+
+	/*
+	 * Queues remain allocated throughout PM. Drain only the hard handler,
+	 * which accesses MMIO without core->lock. A pending thread may need
+	 * that mutex; its command writes are blocked while suspended.
+	 */
+	if (!iris_vpu_watchdog(core, core->intr_status))
+		disable_irq_nosync(core->irq);
+	synchronize_hardirq(core->irq);
+	iris_vpu_power_off_resources(core);
+}
+
+int iris_vpu5_suspend(struct iris_core *core)
+{
+	int ret;
+
+	lockdep_assert_held(&core->lock);
+	if (core->legacy_pm_suspended)
+		return 0;
+
+	ret = iris_vpu5_prepare_pc(core);
+	if (ret)
+		return ret;
+
+	ret = iris_set_hw_state(core, false);
+	if (ret)
+		return ret;
+
+	core->legacy_pm_suspended = true;
+	iris_vpu5_pm_power_off(core);
+	return 0;
+}
+
+int iris_vpu5_resume(struct iris_core *core)
+{
+	int ret;
+
+	lockdep_assert_held(&core->lock);
+	if (!core->legacy_pm_suspended)
+		return 0;
+
+	ret = iris_vpu_power_on(core);
+	if (ret)
+		goto error;
+
+	ret = iris_set_hw_state(core, true);
+	if (ret)
+		goto err_power_off;
+
+	ret = iris_vpu_boot_firmware(core);
+	if (ret)
+		goto err_suspend_hw;
+
+	/* Restore cache resources for retained sessions, before any new open. */
+	core->legacy_pm_suspended = false;
+	if (core->hfi_sys_ops->sys_restore_resources) {
+		ret = core->hfi_sys_ops->sys_restore_resources(core);
+		if (ret)
+			goto err_suspend_hw;
+	}
+	return 0;
+
+err_suspend_hw:
+	core->legacy_pm_suspended = true;
+	iris_set_hw_state(core, false);
+err_power_off:
+	iris_vpu5_pm_power_off(core);
+error:
+	core->state = IRIS_CORE_ERROR;
+	dev_err(core->dev, "failed to restore balanced VPU5 context: %d\n", ret);
+	return ret;
+}
